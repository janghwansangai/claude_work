# Cloudflare Pages 정적 응답 헤더 (PRD §12.1). 학교 LMS iframe 임베드가 필요하면
# frame-ancestors 에 해당 학교 origin만 정확히 추가할 것.
# frame-src: '실제 사이트와 나란히' 화면에서 교사가 넣은 실제 사이트 주소를 오른쪽에 보여 주기 위해 허용한다.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https: http:; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable
