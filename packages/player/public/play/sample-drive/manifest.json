{
  "schemaVersion": 2,
  "id": "sample-drive",
  "version": "1.0.0",
  "title": "가상 파일 공유 연습",
  "notice": "모의 실습입니다. 실제 계정과 실제 비밀번호를 입력하지 마세요.",
  "mode": "practice",
  "viewport": { "width": 1280, "height": 720, "dpr": 1 },
  "startStepId": "s1",
  "assets": {
    "base1": "../../assets/dummy-1.svg",
    "base2": "../../assets/dummy-2.svg"
  },
  "steps": [
    {
      "id": "s1",
      "type": "click",
      "assetId": "base1",
      "instruction": "새 폴더 버튼을 누르세요.",
      "hotspots": [
        { "id": "new-folder", "rect": [0.10, 0.20, 0.13, 0.07], "nextStepId": "s2" }
      ],
      "hint": "왼쪽 상단의 새로 만들기를 찾아보세요."
    },
    {
      "id": "s2",
      "type": "input",
      "assetId": "base2",
      "instruction": "가상 폴더 이름을 입력하세요.",
      "input": {
        "mode": "sample-text",
        "placeholder": "예: 우리반_예제",
        "acceptedValues": ["우리반_예제"],
        "storeInput": false
      },
      "nextStepId": "s3"
    },
    {
      "id": "s3",
      "type": "choice",
      "assetId": "base2",
      "instruction": "공유 범위를 선택하세요.",
      "choices": [
        { "label": "제한됨", "nextStepId": "success" },
        { "label": "링크가 있는 모든 사용자", "nextStepId": "retry" }
      ]
    },
    {
      "id": "success",
      "type": "click",
      "assetId": "base2",
      "instruction": "성공! 제대로 설정했습니다.",
      "hotspots": []
    },
    {
      "id": "retry",
      "type": "click",
      "assetId": "base2",
      "instruction": "다시 선택하세요. 공개 링크는 위험할 수 있습니다.",
      "hotspots": [
        { "id": "back", "rect": [0, 0, 1, 1], "nextStepId": "s3" }
      ]
    }
  ]
}
