{
  "manifest_version": 3,
  "name": "실습 녹화기",
  "version": "1.1.0",
  "description": "수업용 모의 실습을 만드는 화면 녹화기 + 로컬 편집기",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [],
  "action": {
    "default_popup": "popup.html",
    "default_title": "실습 녹화기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "editor-bridge.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
