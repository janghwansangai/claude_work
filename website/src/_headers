# Cloudflare 정적 응답 헤더
# 오류 신고 위젯: script.google.com(위젯·전송)과 script.googleusercontent.com(Apps Script 응답)을 허용한다.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'none'; script-src 'self' https://script.google.com https://script.googleusercontent.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://script.google.com https://script.googleusercontent.com; font-src 'self'; connect-src 'self' https://api.github.com https://script.google.com https://script.googleusercontent.com; frame-src https: http:; base-uri 'none'; form-action https://script.google.com https://script.googleusercontent.com; object-src 'none'; frame-ancestors 'none'

# 체험용 실습(학생 화면)은 검색에 노출하지 않는다. 학생 화면은 외부로 아무것도 보내지 않으므로
# 위 정책에 더해 원래의 엄격한 정책을 함께 적용한다(정책이 두 개면 브라우저는 둘 다 지킨다).
/demo/*
  X-Robots-Tag: noindex
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https: http:; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'

/img/*
  Cache-Control: public, max-age=86400
